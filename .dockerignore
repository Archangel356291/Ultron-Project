# Build context here is the repo root (docker-compose.yml -> ultron-backend
# service), so this file is what actually keeps .git/, dev-tools/, .env,
# graphify-out/, this whole Obsidian vault, etc. out of the backend image —
# today's Dockerfile COPYs are specific enough to not need it, but that's a
# property of the Dockerfile, not a guarantee; deny-by-default means a
# looser COPY later (e.g. "COPY . .") can't silently start shipping any of
# this without someone also editing this allowlist.

# ==============================================================================
# 1. DENY-BY-DEFAULT (ignore everything first)
# ==============================================================================
**

# ==============================================================================
# 2. ALLOWLIST — exactly what ultron-backend/Dockerfile COPYs:
#    ultron-backend/ (requirements.txt + app.py + its own docs/scripts),
#    ultron-dashboard.html (app.py serves it from one directory up), and
#    three-pipeline/ (Module 13: vendored Three.js + the built hero-head
#    .glb, served by app.py's /three-pipeline/<file> route).
# ==============================================================================
!ultron-backend/
!ultron-backend/**
!ultron-dashboard.html
!sw.js
!three-pipeline/
!three-pipeline/**
!pixel-assets/
!pixel-assets/**
# Pixel-game data modules (loot engine, palettes, combat), served by app.py's
# /pixel-game/<file> route. JS + docs only; no secrets here.
!pixel-game/
!pixel-game/**
# Self-hosted dashboard typefaces (OFL woff2 + their README), served by
# app.py's /fonts/<file> route.
!fonts/
!fonts/**
# Home-tab knowledge graph: graph.json only -- NOT the rest of
# graphify-out/ (cache/, obsidian/, private-nodes.enc.json, which must
# never be shipped even encrypted, per Module 9's own rule).
!graphify-out/graph.json

# ==============================================================================
# 3. EXPLICIT BLOCKS (strip junk/secrets back out of the allowlisted tree,
#    even though ultron-backend/** above would otherwise let it through)
# ==============================================================================

# Secrets & local data
**/.env*
**/secrets/
**/credentials*.json
**/*.db
# Host-issued Tailscale TLS cert/key -- bind-mounted at runtime instead
# (see docker-compose.yml), never baked into the image.
ultron-backend/tls/

# Claude Code / AI agent metadata
**/.claude/
**/.anthropic/
**/claude.log

# Local dev & IDEs
**/.git/
**/.github/
**/.vscode/
**/.idea/
**/*.swp

# OS junk
**/.DS_Store
**/Thumbs.db

# Build artifacts & runtimes
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/venv/
**/.venv/
**/.pytest_cache/

# three-pipeline/: dev-only smoke tests, the Blender build script, and the
# render preview -- none of these are fetched by the dashboard at runtime,
# only three.module.js/three.core.js/loaders/utils and hero_head.glb are.
three-pipeline/*.html
three-pipeline/*.py
three-pipeline/*.png
three-pipeline/*.glb
!three-pipeline/hero_head.glb
three-pipeline/README.md
