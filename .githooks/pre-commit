#!/bin/sh
# gitleaks secret scan -- added per Module 3 of the roadmap ("mandatory
# gate" for every commit, and before any future open-source visibility
# change). Fails CLOSED: if gitleaks isn't found, the commit is blocked
# rather than silently skipping the scan -- a secret scanner that's
# quietly disabled is worse than no scanner, because it looks protected.
#
# Config: ../../.gitleaks.toml (path-scoped allowlist for the two
# verified false positives from the Module 3 audit -- see
# GIT-SECRET-AUDIT.md). If you hit a genuine new false positive, add a
# scoped path entry there and explain why in the commit that adds it --
# never widen it to a content/regex pattern.

GITLEAKS_BIN="$(command -v gitleaks 2>/dev/null)"
if [ -z "$GITLEAKS_BIN" ]; then
    for candidate in \
        "$HOME/AppData/Local/Microsoft/WinGet/Packages/Gitleaks.Gitleaks_Microsoft.Winget.Source_8wekyb3d8bbwe/gitleaks.exe"
    do
        if [ -x "$candidate" ]; then GITLEAKS_BIN="$candidate"; break; fi
    done
fi

if [ -z "$GITLEAKS_BIN" ]; then
    echo "[pre-commit] gitleaks not found -- refusing to commit without a secret scan." >&2
    echo "[pre-commit] install it: winget install --id Gitleaks.Gitleaks -e" >&2
    exit 1
fi

"$GITLEAKS_BIN" protect --staged --source . -c .gitleaks.toml -v
status=$?
if [ $status -ne 0 ]; then
    echo "[pre-commit] gitleaks found a likely secret in staged changes -- commit blocked." >&2
    echo "[pre-commit] fix it, or if this is a genuine false positive, add a scoped path entry" >&2
    echo "[pre-commit] to .gitleaks.toml (never a blanket content/regex one) and explain why." >&2
    exit 1
fi
exit 0
