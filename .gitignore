# Custom AI & Claude Code -- local state stays out, but the project's
# subagent definitions (.claude/agents/*.md) are source and travel with it.
.claude/*
!.claude/agents/
claude-code.log
*.log
.env
.env.*
!.env.example

# Secrets & data (this project's SQLite DB holds trade/financial records)
*.db*
*.pem
*.key
*.pfx
id_rsa
id_ed25519
credentials.json

# Tailscale TLS cert/key for the backend (host-specific, machine-issued --
# see odin-backend/tls/README.md, which stays tracked)
odin-backend/tls/*.crt
odin-backend/tls/*.key

# Encrypted private knowledge-graph nodes (graph-schema/enrich_visibility.py).
# Never committed even though it's encrypted -- see GRAPH-SCHEMA-DESIGN.md;
# Module 9's own rule is that private graph content never enters repo history,
# encryption is defense in depth, not a license to commit it anyway.
graphify-out/private-nodes.enc.json

# Module 7 write-path: an un-reviewed draft session-summary node.
# Ephemeral working state (like graphify's own .graphify_* temp files),
# never a deliverable -- see session-write/README.md. Approving it moves
# the real content into graphify-out/graph.json, which IS committed.
session-write/pending-review.json

# Module 12: machine-local sidecar the graphify skill writes, pointing at
# THIS machine's own Python interpreter path -- meaningless on a fresh
# clone and, worse, leaks the local Windows username. Local-environment
# state, same category as .env; the skill regenerates it on next run.
graphify-out/.graphify_python

# Python (3.10)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
pip-log.txt
pip-delete-this-directory.txt
*.pid

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
dist/
build/

# Windows 11 System Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# IDEs and Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Obsidian — local app state (workspace layout, installed plugin bundles,
# recently-opened file paths), not project source. Root-anchored on
# purpose: graphify-out/obsidian/.obsidian/ is graphify's own generated
# vault config and stays tracked.
/.obsidian/

# Ultron's Brain & Knowledge mirrors -- written next to odin.db (D:\ultron's
# Brain&Knowledge in Docker); if the backend is ever run bare with the default
# DB path they would land here, and they are runtime data, never source.
# Sandboxed SAST reports (dev-tools/sast-scan.sh) -- regenerated on demand.
/dev-tools/sast-reports/
/odin-backend/knowledge/
/odin-backend/chat logs/
/odin-backend/graphify-out/
