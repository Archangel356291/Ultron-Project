{"nodes": [{"id": "ultron_backend_beta_launch_checklist_phase1_status", "label": "Phase 1 Status (complete, 2026-09-13)", "file_type": "document", "source_file": "ultron-backend/BETA-LAUNCH-CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Core backend + dashboard + chat + voice verified against a real running instance, not just 'should work'."}, {"id": "ultron_backend_beta_launch_checklist_start_ultron_script", "label": "start-ultron.ps1", "file_type": "concept", "source_file": "ultron-backend/BETA-LAUNCH-CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consolidates every environment variable the backend reads into one editable script, commented with required ones un-commented and optional ones commented out, to avoid retyping/fat-fingering env vars each session."}, {"id": "ultron_backend_beta_launch_checklist_ultron_api_token", "label": "ULTRON_API_TOKEN (required env var)", "file_type": "concept", "source_file": "ultron-backend/BETA-LAUNCH-CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The app refuses to start without it; it is the bearer token every client (dashboard, bot) needs to talk to the backend."}, {"id": "ultron_backend_beta_launch_checklist_anthropic_api_key", "label": "ANTHROPIC_API_KEY (real beta key)", "file_type": "concept", "source_file": "ultron-backend/BETA-LAUNCH-CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without it every panel except AI Assistant chat still works; chat returns a clear 503 until this is set."}, {"id": "ultron_backend_beta_launch_checklist_tts_voice", "label": "Voice / TTS (Fish Audio, /api/tts)", "file_type": "concept", "source_file": "ultron-backend/BETA-LAUNCH-CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified end-to-end: /api/tts returns real playable MP3 through the actual backend route; mic input wired to the browser's native speech recognition; network-level success confirmed but not yet ear-confirmed."}, {"id": "ultron_backend_beta_launch_checklist_security_pass", "label": "Security Pass (gitignore hardening, token scrub, bandit SAST)", "file_type": "rationale", "source_file": "ultron-backend/BETA-LAUNCH-CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "gitignore hardened (a real gap \u2014 *.db had been dropped); a hardcoded bearer token found and scrubbed from git history before it was ever pushed; a SAST pass (bandit) came back clean; no secrets confirmed anywhere in git history or GitHub."}, {"id": "ultron_backend_beta_launch_checklist_smoke_test", "label": "7-Step Smoke Test", "file_type": "concept", "source_file": "ultron-backend/BETA-LAUNCH-CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Home page, AI Assistant tool call, Home Lab Docker containers, usage/cost card, backup preview (don't confirm), record a test trade, Discord /status \u2014 each exercises a genuinely different part of the system."}, {"id": "ultron_backend_beta_launch_checklist_discord_bot_setup", "label": "Discord Bot Setup (start-bot.ps1)", "file_type": "concept", "source_file": "ultron-backend/BETA-LAUNCH-CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needs the same ULTRON_API_TOKEN plus a Discord bot token and the user's Discord user ID; the bot refuses to start without all three."}, {"id": "ultron_backend_beta_launch_checklist_mcp_config", "label": "ULTRON_MCP_CONFIG (optional MCP feature)", "file_type": "concept", "source_file": "ultron-backend/BETA-LAUNCH-CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marked 'later \u2014 read the backend README's External tools (MCP) section first, this is the one with real security implications'."}, {"id": "ultron_backend_beta_launch_checklist_daily_token_budget", "label": "ULTRON_LLM_DAILY_TOKEN_BUDGET", "file_type": "concept", "source_file": "ultron-backend/BETA-LAUNCH-CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Worth setting during beta specifically as a real ceiling while finding out actual usage; enforced by default at 50k."}, {"id": "ultron_backend_beta_launch_checklist_chat_rate_limit", "label": "ULTRON_CHAT_RATE_LIMIT_PER_MINUTE", "file_type": "concept", "source_file": "ultron-backend/BETA-LAUNCH-CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Already on by default (20/min); only touch if it's actually hit."}, {"id": "ultron_backend_beta_launch_checklist_backup_feature", "label": "Backup Feature (ULTRON_BACKUP_SOURCES / DEST)", "file_type": "concept", "source_file": "ultron-backend/BETA-LAUNCH-CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Low risk, two-step confirm; worth turning on now if there's something worth backing up."}, {"id": "ultron_backend_beta_launch_checklist_dev_tab_feature", "label": "Development Tab Feature (ULTRON_CODE_REPOS)", "file_type": "concept", "source_file": "ultron-backend/BETA-LAUNCH-CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ultron_backend_beta_launch_checklist_remote_access", "label": "Remote Access / Tailscale (optional, always-on)", "file_type": "concept", "source_file": "ultron-backend/BETA-LAUNCH-CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neither remote access nor always-on is needed to start beta testing today; both are for running continuously rather than only while at the PC."}, {"id": "ultron_backend_beta_launch_checklist_known_behaviors", "label": "Known By-Design Beta Behaviors", "file_type": "rationale", "source_file": "ultron-backend/BETA-LAUNCH-CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First chat message is slower (one-time tool/MCP discovery, not a hang); CVE scanning is genuinely slow and manual-only by design; backup/deploy never run without clicking Confirm \u2014 chat tells you to use the dashboard instead; a closed PowerShell window stops the backend unless Task Scheduler is set up."}], "edges": [{"source": "ultron_backend_beta_launch_checklist_phase1_status", "target": "ultron_backend_beta_launch_checklist_start_ultron_script", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ultron-backend/BETA-LAUNCH-CHECKLIST.md", "source_location": null, "weight": 1.0}, {"source": "ultron_backend_beta_launch_checklist_phase1_status", "target": "ultron_backend_beta_launch_checklist_ultron_api_token", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ultron-backend/BETA-LAUNCH-CHECKLIST.md", "source_location": null, "weight": 1.0}, {"source": "ultron_backend_beta_launch_checklist_phase1_status", "target": "ultron_backend_beta_launch_checklist_anthropic_api_key", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ultron-backend/BETA-LAUNCH-CHECKLIST.md", "source_location": null, "weight": 1.0}, {"source": "ultron_backend_beta_launch_checklist_phase1_status", "target": "ultron_backend_beta_launch_checklist_tts_voice", "relation": "references", "confidence": "E